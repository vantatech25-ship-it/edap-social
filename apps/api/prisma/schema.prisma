generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum PostPrivacy {
  PUBLIC
  FRIENDS
  PRIVATE
  CUSTOM
}

enum ReactionEntityType {
  POST
  COMMENT
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

enum NotificationType {
  FOLLOW
  REACTION
  COMMENT
}

enum NotificationEntityType {
  USER
  POST
  COMMENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  dateOfBirth  DateTime?
  isVerified   Boolean  @default(false)
  role         UserRole @default(USER)
  posts        Post[]
  stories      Story[]
  comments     Comment[]
  reactions    Reaction[]
  messagesSent Message[] @relation("SentMessages")
  followers    Connection[] @relation("followers")
  following    Connection[] @relation("following")
  groupMemberships GroupMember[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  notifications Notification[] @relation("UserNotifications")
  actedNotifications Notification[] @relation("ActorNotifications")
}

model Connection {
  followerId  String           @db.Uuid
  followingId String           @db.Uuid
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  follower    User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
  @@index([followerId, status], map: "idx_connections_follower_status")
  @@index([followingId, status], map: "idx_connections_following_status")
}

model Post {
  id        String      @id @default(uuid()) @db.Uuid
  authorId  String      @db.Uuid
  content   String
  mediaUrls Json?
  privacy   PostPrivacy @default(PUBLIC)
  groupId   String?     @db.Uuid
  group     Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([authorId, createdAt(sort: Desc)], map: "idx_posts_author_created")
  @@index([groupId, createdAt(sort: Desc)], map: "idx_posts_group_created")
}

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  postId          String   @db.Uuid
  authorId        String   @db.Uuid
  parentCommentId String?  @db.Uuid
  content         String
  createdAt       DateTime @default(now())
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent          Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")
  @@index([postId, createdAt], map: "idx_comments_post_created")
}

model Reaction {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  entityType   ReactionEntityType
  entityId     String            @db.Uuid
  reactionType ReactionType
  createdAt    DateTime          @default(now())
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @db.Uuid
  senderId  String   @db.Uuid
  content   String
  mediaUrl  String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  @@index([threadId, createdAt])
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @db.Uuid
  actorId    String?                @db.Uuid
  type       NotificationType
  entityType NotificationEntityType
  entityId   String?                @db.Uuid
  message    String?
  isRead     Boolean                @default(false)
  createdAt  DateTime               @default(now())

  user       User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor      User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead, createdAt(sort: Desc)])
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

model Group {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  coverUrl    String?
  privacy     GroupPrivacy  @default(PUBLIC)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  posts       Post[]
}

model GroupMember {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  userId    String    @db.Uuid
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now())
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Story {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @db.Uuid
  mediaUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, expiresAt])
}
